<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGen.World</RootNamespace>
    <AssemblyName>NextGen.World</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!--
      PerformanceCounter.cs nutzt System.Diagnostics.PerformanceCounter (echte
      Windows-Performance-Counter-API). Das Paket ist Windows-only zur
      Laufzeit (wirft PlatformNotSupportedException unter Linux/macOS) -
      im Original war das bereits so (nur eben via .NET-Framework-eigene
      Assembly statt NuGet-Paket). Siehe DOCUMENTATION.md.
    -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NextGen.Database\NextGen.Database.csproj" />
    <ProjectReference Include="..\NextGen.FiestaLib\NextGen.FiestaLib.csproj" />
    <ProjectReference Include="..\NextGen.InterLib\NextGen.InterLib.csproj" />
    <ProjectReference Include="..\NextGen.Util\NextGen.Util.csproj" />
  </ItemGroup>

  <!-- Siehe Kommentar in NextGen.Login.csproj. -->
  <ItemGroup>
    <None Include="..\Config.cfg" Link="Config.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    System.ServiceModel, System.IdentityModel(.Selectors), System.Data.Entity,
    System.Windows.Forms und System.Drawing waren referenziert, aber
    nachweislich (grep) nirgends im Code genutzt - toter Balast. Nicht
    uebernommen; macht das Projekt nebenbei auch tatsaechlich
    plattformunabhaengiger (Windows/Linux), analog zum Cross-Platform-Ziel
    des TheSeed-Map-Editor-Projekts.
  -->

  <!--
    Data/CommercialReqest.cs, Data/ZoneInfo.cs, Managers/CommercialManager.cs
    standen im Original NICHT in der Compile-Include-Liste. Bewusst weiterhin
    ausgeschlossen statt ungeprueft scharfzuschalten. Siehe DOCUMENTATION.md,
    Abschnitt "Bislang ausgeschlossene Dateien".
  -->
  <ItemGroup>
    <Compile Remove="Data\CommercialReqest.cs" />
    <Compile Remove="Data\ZoneInfo.cs" />
    <Compile Remove="Managers\CommercialManager.cs" />
  </ItemGroup>

</Project>
