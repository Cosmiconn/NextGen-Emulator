<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGen.Zone</RootNamespace>
    <AssemblyName>NextGen.Zone</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- Siehe Kommentar in NextGen.World.csproj: Windows-only zur Laufzeit. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NextGen.Database\NextGen.Database.csproj" />
    <ProjectReference Include="..\NextGen.FiestaLib\NextGen.FiestaLib.csproj" />
    <ProjectReference Include="..\NextGen.InterLib\NextGen.InterLib.csproj" />
    <ProjectReference Include="..\NextGen.Util\NextGen.Util.csproj" />
  </ItemGroup>

  <!-- Siehe Kommentar in NextGen.Login.csproj. -->
  <ItemGroup>
    <None Include="..\Config.cfg" Link="Config.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    System.ServiceModel war referenziert, aber nachweislich (grep) nirgends im
    Code genutzt - toter Balast, nicht uebernommen.

    Die Resources.resx/Resources.Designer.cs enthielten ausschliesslich den
    unveraenderten Visual-Studio-Platzhaltertext (nie befuellt, nirgends
    referenziert) - geloescht statt migriert.
  -->

  <!--
    Security/CheatTracker.cs stand im Original NICHT in der Compile-Include-
    Liste. Bewusst weiterhin ausgeschlossen. Siehe DOCUMENTATION.md,
    Abschnitt "Bislang ausgeschlossene Dateien".
  -->
  <ItemGroup>
    <Compile Remove="Security\CheatTracker.cs" />
  </ItemGroup>

</Project>
